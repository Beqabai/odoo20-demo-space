<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_process" model="res.groups.privilege">
        <field name="name">Business Processes</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_process_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_process"/>
        <field name="comment">Reads published processes and their work instructions.</field>
    </record>

    <record id="group_process_manager" model="res.groups">
        <field name="name">Process Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_process"/>
        <field name="implied_ids" eval="[(4, ref('group_process_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Models, versions, reviews and publishes processes.</field>
    </record>

    <!-- Every internal user is a viewer: the process map is for the whole company. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_process_user'))]"/>
    </record>

    <!-- Access rights: Odoo 19 uses ir.model.access + ir.rule, Odoo 20 replaced both by
         ir.access. The right file is loaded by this call on install and on every update. -->
    <function model="business.process" name="_bpmn_load_access_rules"/>
</odoo>
