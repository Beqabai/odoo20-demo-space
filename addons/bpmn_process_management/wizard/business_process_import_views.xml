<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="business_process_import_view_form" model="ir.ui.view">
        <field name="name">business.process.import.form</field>
        <field name="model">business.process.import</field>
        <field name="arch" type="xml">
            <form string="Import Diagram">
                <div class="alert alert-info mb-3" role="status">
                    Supported files: <b>.bpmn</b> (Camunda, Signavio, bpmn.io, Bizagi...),
                    <b>.drawio / .xml / .svg / .png</b> exported from draw.io with the diagram
                    included, and <b>.vsdx</b> (Microsoft Visio 2013 or later).
                    Converted diagrams are flagged for review: lanes need a department or role,
                    guessed shapes should be checked.
                </div>
                <group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="mode" widget="radio"/>
                        <field name="process_id" invisible="mode != 'replace'"
                               required="mode == 'replace'" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="pages" widget="radio" invisible="mode == 'replace'"/>
                        <field name="category" invisible="mode == 'replace'"/>
                        <field name="parent_id" invisible="mode == 'replace'"
                               options="{'no_create': True}"/>
                        <field name="match_responsibles"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="business_process_import_action" model="ir.actions.act_window">
        <field name="name">Import Diagram</field>
        <field name="res_model">business.process.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
