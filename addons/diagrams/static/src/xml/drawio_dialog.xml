<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="diagrams.DrawioDialog">
    <Dialog size="'fullscreen'" fullscreen="true" header="false" footer="false" contentClass="'o_diagrams_drawio_dialog'" withBodyPadding="false">
        <div class="o_diagrams_drawio_container">
            <div class="o_diagrams_loading" t-if="!state.isReady">
                <div class="spinner-border text-primary" role="status" aria-label="Loading"/>
            </div>
            <iframe
                t-ref="iframe"
                t-att-src="iframeSrc"
                class="o_diagrams_drawio_iframe"
                frameborder="0"
                allowfullscreen="allowfullscreen"
            />
        </div>
    </Dialog>
</t>

</templates>
